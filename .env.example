# Copy this file to ".env" (same folder) and fill in your real token.
# ".env" is gitignored — never commit your actual token.
#
# Create one at: https://github.com/settings/tokens
#   - Classic token: needs the "repo" scope
#   - Fine-grained token: needs read/write access to "Contents" for this repo
#
# Once .env exists with a real GH_TOKEN, "npm run release" will pick it up
# automatically in any terminal — no need to export it manually each time.

GH_TOKEN=your_github_personal_access_token_here

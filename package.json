{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "gofresh-sales-dashboard",
  "productName": "GoFresh Sales Dashboard",
  "version": "1.1.1",
  "description": "GoFresh RetailMax Sales Intelligence Dashboard (desktop app)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:python": "node scripts/build-python.js",
    "predist": "npm run build:python",
    "dist": "electron-builder --win",
    "prerelease": "npm run build:python",
    "release": "dotenv -e .env -- electron-builder --win --publish always"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "yauzl": "^3.3.1"
  },
  "build": {
    "appId": "com.gofresh.salesdashboard",
    "productName": "GoFresh Sales Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "splash-preload.js",
      "index.html",
      "assets/**/*",
      "data/**/*"
    ],
    "asarUnpack": [
      "data/**/*"
    ],
    "icon": "assets/icons/icon.ico",
    "extraResources": [
      {
        "from": "build-resources/python",
        "to": "python"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "VictorKaml",
      "repo": "gofresh-analytics",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}